{
  "expo": {
    "name": "Duty Free Guide",
    "slug": "dutyfree-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dutyfreeguide",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinaysinghts.dutyfreeguide"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vinaysinghts.dutyfreeguide",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo of a shelf price tag to report its price.",
          "cameraPermission": "Snap a shelf price tag to report its price."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "While the app is open, we use your location to notice when you're at an airport and to confirm where a price-tag photo was taken. Never in the background. It's only sent with a price report."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E6F4FE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
